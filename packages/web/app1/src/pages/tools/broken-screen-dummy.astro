---
import BaseLayout from "../../layouts/BaseLayout.astro";
import RelatedTools from "../../components/RelatedTools.astro";
import ColorHub from "../../components/ColorHub.astro";
import ToolCards from "../../components/ToolCards.astro";
import ScreenGallery from "../../components/ScreenGallery.astro";
import { getUI } from "../../i18n";
import tools from "../../data/tools.json";

const tool = tools.find((t) => t.slug === "broken-screen-dummy")!;
const site = "https://blankpane.com";
const t = getUI("en");

const webAppLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "Broken Screen Dummy",
  applicationCategory: "UtilitiesApplication",
  operatingSystem: "Any",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  description: "Realistic cracked, shattered, and glitched screen overlays. Free prank tool — pick a break style and go full screen to trick your friends.",
};
const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    { "@type": "Question", name: "Will this actually damage my screen?", acceptedAnswer: { "@type": "Answer", text: "Not at all. The cracks are drawn with SVG and CSS — purely visual overlays. Press Esc at any time and your screen returns to normal instantly." } },
    { "@type": "Question", name: "Can I export the cracked screen as an image?", acceptedAnswer: { "@type": "Answer", text: "Yes — click Download PNG to save a 1920×1080 image of the current crack style. Perfect for sharing as a joke on social media." } },
    { "@type": "Question", name: "Which break style looks most realistic?", acceptedAnswer: { "@type": "Answer", text: "The spiderweb crack with a dark background is the most convincing — the radiating lines from the impact point create a familiar shattered-glass look. LCD bleed works best if your target has seen a physically damaged LCD before." } },
  ],
};
const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${site}/` },
    { "@type": "ListItem", position: 2, name: "Tools", item: `${site}/tools/` },
    { "@type": "ListItem", position: 3, name: "Broken Screen Dummy", item: `${site}/tools/broken-screen-dummy/` },
  ],
};

const styles = ["spiderweb-crack","full-shatter","dead-pixel-lines","lcd-bleed","vertical-glitch"];
const styleLabel: Record<string, string> = { "spiderweb-crack":"Spiderweb Crack","full-shatter":"Full Shatter","dead-pixel-lines":"Dead Pixel Lines","lcd-bleed":"LCD Bleed","vertical-glitch":"Vertical Glitch" };
---

<BaseLayout
  lang="en"
  localized={false}
  title="Broken Screen Dummy — Realistic Crack & Shatter Effect Prank"
  description="5 realistic broken-screen styles: spiderweb crack, full shatter, LCD bleed, glitch, dead-pixel lines. Free, instant, Esc to exit — harmless prank."
  canonical={`${site}/tools/broken-screen-dummy/`}
  jsonLd={[webAppLd, faqLd, breadcrumbLd]}
>
  <div class="page" style="max-width:720px;">
    <p class="back"><a href="/tools/">← All tools</a></p>
    <h1>Broken Screen Dummy</h1>
    <p class="lede">
      You hand someone your phone or laptop, and they freeze — because the screen looks freshly shattered. This tool
      overlays a convincing crack or damage effect on top of your actual desktop. Pick from five styles: a spiderweb
      crack radiating from an impact point, a full shattered-glass mosaic, horizontal dead-pixel lines, a purple LCD
      bleed stain, or a chaotic vertical glitch. None of it is real — it's all SVG and CSS rendered in your browser.
      Tap Esc and your screen is back to pristine. Totally harmless, and way more fun than it should be.
    </p>

    <section>
      <h2>How to use</h2>
      <ol>
        <li>Pick a <strong>break style</strong> from the buttons below — the preview updates instantly.</li>
        <li>Hit <strong>Full Screen</strong> and hand the device to your unsuspecting victim.</li>
        <li>Press <strong>Esc</strong> to remove the overlay — no permanent marks, no actual damage.</li>
      </ol>
    </section>

    <p style="font-size:.75rem;color:var(--ink-dim);font-family:var(--mono);text-align:center;margin:0 0 16px;">Harmless prank — nothing here damages your screen. Press Esc to exit.</p>

    <div style="display:flex;gap:8px;flex-wrap:wrap;justify-content:center;margin-bottom:16px;">
      {styles.map((s) => (
        <button class="btn btn-outline" data-style={s} style="font-size:.72rem;padding:6px 10px;">{styleLabel[s]}</button>
      ))}
    </div>

    <div id="preview-box" style="width:100%;aspect-ratio:16/9;border-radius:18px;border:1px solid var(--line);overflow:hidden;position:relative;background:#111;box-shadow:0 20px 60px -20px rgba(0,0,0,0.6);">
      <svg id="crack-svg" viewBox="0 0 1920 1080" preserveAspectRatio="xMidYMid slice" style="position:absolute;inset:0;width:100%;height:100%;pointer-events:none;"></svg>
      <div id="glitch-overlay" style="position:absolute;inset:0;display:none;"></div>
      <div id="lcd-overlay" style="position:absolute;inset:0;display:none;"></div>
    </div>

    <div class="action-row" style="margin-top:16px;">
      <button class="btn" id="full-btn">Full Screen</button>
      <button class="btn btn-outline" id="dl-btn">Download PNG</button>
    </div>
    <p class="hint">Tip: press F for full screen · Esc to exit</p>

    <details open>
      <summary>Will this actually damage my screen?</summary>
      <p>Not at all. The cracks are drawn with SVG and CSS — purely visual overlays. Press Esc at any time and your screen returns to normal instantly.</p>
    </details>
    <details>
      <summary>Can I export the cracked screen as an image?</summary>
      <p>Yes — click Download PNG to save a 1920×1080 image of the current crack style. Perfect for sharing as a joke on social media.</p>
    </details>
    <details>
      <summary>Which break style looks most realistic?</summary>
      <p>The spiderweb crack with a dark background is the most convincing — the radiating lines from the impact point create a familiar shattered-glass look. LCD bleed works best if your target has seen a physically damaged LCD before.</p>
    </details>

    <ScreenGallery
      title="Realistic Broken Screen Wallpapers"
      files={["01-spiderweb-crack", "02-full-shatter", "11-cracked-corner-impact", "05-lcd-backlight-bleed", "08-pressure-damage", "14-crushed-lcd"]}
      lede="Free cracked and shattered screen wallpaper images you can download and set as a prank desktop background."
    />
    <RelatedTools slugs={tool.relatedSlugs} />
    <ColorHub t={t} />
    <ToolCards title="More Screen Tools" limit={6} />
  </div>
</BaseLayout>

<script>
// @ts-nocheck
  const svg = document.getElementById("crack-svg");
  const glitch = document.getElementById("glitch-overlay");
  const lcd = document.getElementById("lcd-overlay");
  let current = "spiderweb-crack";

  function drawSpiderweb() {
    svg.innerHTML = "";
    glitch.style.display = "none";
    lcd.style.display = "none";
    const cx = 920 + (Math.random()-0.5)*400, cy = 540 + (Math.random()-0.5)*300;
    for (let i = 0; i < 14; i++) {
      const angle = (i / 14) * Math.PI * 2 + (Math.random()-0.5)*0.4;
      const len = 800 + Math.random()*600;
      const ex = cx + Math.cos(angle)*len, ey = cy + Math.sin(angle)*len;
      const cpx = cx + Math.cos(angle+0.2)*len*0.4, cpy = cy + Math.sin(angle+0.2)*len*0.4;
      const path = document.createElementNS("http://www.w3.org/2000/svg","path");
      path.setAttribute("d",`M${cx} ${cy} Q${cpx} ${cpy} ${ex} ${ey}`);
      path.setAttribute("stroke","rgba(255,255,255,0.55)");
      path.setAttribute("stroke-width",(2+Math.random()*3).toFixed(1));
      path.setAttribute("fill","none");
      path.setAttribute("stroke-linecap","round");
      svg.appendChild(path);
    }
    for (let i=0;i<6;i++){
      const r=200+Math.random()*500;
      const a=Math.random()*Math.PI*2;
      const c=document.createElementNS("http://www.w3.org/2000/svg","circle");
      c.setAttribute("cx",cx+Math.cos(a)*r*0.4);
      c.setAttribute("cy",cy+Math.sin(a)*r*0.4);
      c.setAttribute("r",(1+Math.random()*4).toFixed(1));
      c.setAttribute("fill","rgba(255,255,255,0.3)");
      svg.appendChild(c);
    }
  }

  function drawShatter() {
    svg.innerHTML = "";
    glitch.style.display = "none";
    lcd.style.display = "none";
    const pieces = 60;
    const cx=960,cy=540;
    for (let i=0;i<pieces;i++){
      const a1=(i/pieces)*Math.PI*2+(Math.random()-0.5)*0.15;
      const a2=((i+1)/pieces)*Math.PI*2+(Math.random()-0.5)*0.15;
      const r1=300+Math.random()*700;
      const r2=300+Math.random()*700;
      const x1=cx+Math.cos(a1)*r1,y1=cy+Math.sin(a1)*r1;
      const x2=cx+Math.cos(a2)*r2,y2=cy+Math.sin(a2)*r2;
      const p=document.createElementNS("http://www.w3.org/2000/svg","polygon");
      p.setAttribute("points",`${cx},${cy} ${x1},${y1} ${x2},${y2}`);
      p.setAttribute("fill","none");
      p.setAttribute("stroke","rgba(255,255,255,0.4)");
      p.setAttribute("stroke-width",(1+Math.random()*2).toFixed(1));
      svg.appendChild(p);
    }
  }

  function drawDeadPixel() {
    svg.innerHTML = "";
    glitch.style.display = "none";
    lcd.style.display = "none";
    for (let i=0;i<12;i++){
      const y=30+i*90+Math.random()*10;
      const l=document.createElementNS("http://www.w3.org/2000/svg","line");
      l.setAttribute("x1","0");l.setAttribute("y1",y);
      l.setAttribute("x2","1920");l.setAttribute("y2",y);
      l.setAttribute("stroke",i%2===0?"#00ff00":"#ff0000");
      l.setAttribute("stroke-width","1");
      l.setAttribute("opacity","0.7");
      svg.appendChild(l);
      const l2=document.createElementNS("http://www.w3.org/2000/svg","line");
      l2.setAttribute("x1","0");l2.setAttribute("y1",y+1);
      l2.setAttribute("x2","1920");l2.setAttribute("y2",y+1);
      l2.setAttribute("stroke","#000");
      l2.setAttribute("stroke-width","1");
      l2.setAttribute("opacity","0.6");
      svg.appendChild(l2);
    }
    for (let i=0;i<30;i++){
      const r=document.createElementNS("http://www.w3.org/2000/svg","rect");
      r.setAttribute("x",Math.random()*1900);r.setAttribute("y",Math.random()*1060);
      r.setAttribute("width","2");r.setAttribute("height","2");
      r.setAttribute("fill","#ff00ff");
      r.setAttribute("opacity","0.8");
      svg.appendChild(r);
    }
  }

  function drawLcdBleed() {
    svg.innerHTML = "";
    glitch.style.display = "none";
    lcd.style.display = "block";
    lcd.style.background = "radial-gradient(ellipse at 30% 60%, rgba(120,0,200,0.5) 0%, rgba(120,0,200,0.2) 30%, transparent 60%), radial-gradient(ellipse at 70% 40%, rgba(80,0,180,0.4) 0%, transparent 50%), radial-gradient(ellipse at 50% 20%, rgba(0,0,0,0.3) 0%, transparent 40%)";
  }

  function drawGlitch() {
    svg.innerHTML = "";
    lcd.style.display = "none";
    glitch.style.display = "block";
    glitch.style.background = "repeating-linear-gradient(transparent 0px, transparent 2px, rgba(0,255,255,0.2) 2px, rgba(255,0,255,0.2) 4px, transparent 4px, transparent 6px)";
    const n=document.createElement("div");
    n.style.cssText="position:absolute;left:20%;top:0;width:15%;height:100%;background:rgba(255,0,0,.15);transform:skewX(-5deg)";
    glitch.appendChild(n);
  }

  const drawFns = { "spiderweb-crack":drawSpiderweb,"full-shatter":drawShatter,"dead-pixel-lines":drawDeadPixel,"lcd-bleed":drawLcdBleed,"vertical-glitch":drawGlitch };

  document.querySelectorAll("[data-style]").forEach(btn=>{
    btn.addEventListener("click",()=>{
      current = btn.dataset.style;
      drawFns[current]();
      document.querySelectorAll("[data-style]").forEach(b=>b.classList.remove("active-style"));
      btn.classList.add("active-style");
    });
  });
  drawSpiderweb();
  // mark first button as active on load
  document.querySelector("[data-style]")?.classList.add("active-style");

  document.getElementById("full-btn").addEventListener("click",()=>{
    const ov = document.getElementById("overlay");
    if (!ov) return;
    ov.innerHTML = "";
    ov.style.alignItems = "center";
    ov.style.justifyContent = "center";
    ov.style.background = "#000";
    const clone = document.getElementById("preview-box").cloneNode(true);
    clone.style.width = "100vw"; clone.style.height = "100vh"; clone.style.aspectRatio = "unset";
    clone.style.borderRadius = "0"; clone.style.position = "absolute"; clone.style.inset = "0";
    clone.style.cursor = "pointer";
    ov.appendChild(clone);
    ov.style.display = "flex";
    document.documentElement.requestFullscreen?.().catch(()=>{});
  });

  const previewBox = document.getElementById("preview-box");
  previewBox.style.cursor = "pointer";
  previewBox.title = "Click for full screen";
  previewBox.addEventListener("click", () => document.getElementById("full-btn").click());

  document.getElementById("dl-btn").addEventListener("click",()=>{
    const c2 = document.createElement("canvas");
    c2.width = 1920; c2.height = 1080;
    const ctx2 = c2.getContext("2d");
    ctx2.fillStyle = "#111"; ctx2.fillRect(0,0,1920,1080);
    const svgData = new XMLSerializer().serializeToString(svg);
    const blob = new Blob([svgData],{type:"image/svg+xml"});
    const url = URL.createObjectURL(blob);
    const img = new Image();
    img.onload = ()=>{
      ctx2.drawImage(img,0,0,1920,1080);
      URL.revokeObjectURL(url);
      c2.toBlob(b=>{if(!b)return;const a=document.createElement("a");a.href=URL.createObjectURL(b);a.download=`broken-screen-${current}.png`;a.click();},"image/png",1.0);
    };
    img.src = url;
  });

  window.__blankpaneFullscreen = () => document.getElementById("full-btn").click();
</script>

