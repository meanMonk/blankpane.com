---
import BaseLayout from "../../layouts/BaseLayout.astro";
import RelatedTools from "../../components/RelatedTools.astro";
import tools from "../../data/tools.json";
import ColorHub from "../../components/ColorHub.astro";
import ToolCards from "../../components/ToolCards.astro";
import { getUI } from "../../i18n";

const tool = tools.find((t) => t.slug === "zoom-light-screen")!;
const site = "https://blankpane.com";
const t = getUI("en");

const webAppLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "Zoom Light Screen",
  applicationCategory: "UtilitiesApplication",
  operatingSystem: "Any",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  description: "Free adjustable color-temperature full-screen light for Zoom, Teams, and video calls. Dial 2700–6500K for natural-looking face lighting.",
};
const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    { "@type": "Question", name: "What Kelvin setting should I use for Zoom calls?", acceptedAnswer: { "@type": "Answer", text: "Daylight (5000–5500 K) looks most natural on most webcams. If your room lighting is warm, match it around 3500 K. Cooler settings (6000 K+) can counter yellow room light but may look clinical." } },
    { "@type": "Question", name: "Does screen brightness affect how I appear on camera?", acceptedAnswer: { "@type": "Answer", text: "Yes — raising brightness increases the fill light but can also wash out your face if set too high. Start around 60–70% and adjust until your face looks evenly lit without squinting." } },
    { "@type": "Question", name: "Can I download a preset color as a PNG?", acceptedAnswer: { "@type": "Answer", text: "Absolutely. After you dial in the perfect shade with the Kelvin slider, hit Download PNG and save a full-resolution solid-color image for use anywhere." } },
  ],
};
const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${site}/` },
    { "@type": "ListItem", position: 2, name: "Tools", item: `${site}/tools/` },
    { "@type": "ListItem", position: 3, name: "Zoom Light Screen", item: `${site}/tools/zoom-light-screen/` },
  ],
};
---

<BaseLayout
  lang="en"
  localized={false}
  title="Zoom Light Screen — Adjustable Color Temperature Fill Light for Video Calls"
  description="Dial in 2700K to 6500K screen light for Zoom, Teams & Meet. Free, instant, no download — adjust brightness, pick a preset, and download a PNG."
  canonical={`${site}/tools/zoom-light-screen/`}
  jsonLd={[webAppLd, faqLd, breadcrumbLd]}
>
  <div class="page" style="max-width:720px;">
    <p class="back"><a href="/tools/">← All tools</a></p>
    <h1>Zoom Light Screen</h1>
    <p class="lede">
      Most built-in webcams struggle in dim rooms — that's what this tool fixes. Instead of buying a physical ring light,
      you can turn your entire display into an adjustable color-temperature fill light. The screen sits right in front of
      your face, so the light hits your features evenly. Dial the Kelvin slider to match your room's bulbs (warm
      incandescent around 3000 K, neutral office light at 4000 K, or daylight-balanced 5500 K) and tweak brightness
      so you look natural without squinting. Works in any browser — no download, no signup, no watermark.
    </p>

    <section>
      <h2>How to use</h2>
      <ol>
        <li>Drag the <strong>Kelvin slider</strong> to set your preferred color temperature (or tap a preset).</li>
        <li>Adjust <strong>brightness</strong> so your face looks evenly lit without blowing out highlights.</li>
        <li>Hit <strong>Full Screen</strong> to fill your monitor or <strong>Download PNG</strong> to save a solid-color image.</li>
      </ol>
    </section>

    <div id="tool-area" style="margin:24px 0;">
      <div id="preview" style="width:100%;aspect-ratio:16/9;border-radius:18px;border:1px solid var(--line);background:#fff7e6;display:flex;align-items:flex-end;padding:16px;box-shadow:0 20px 60px -20px rgba(0,0,0,0.6);cursor:pointer;" title="Click for full screen" onclick="document.getElementById('full-btn').click();">
        <span style="font-family:var(--mono);font-size:.72rem;padding:6px 10px;border-radius:6px;background:rgba(0,0,0,.45);color:#fff;" id="kv-label">3000 K — Warm/Office</span>
      </div>

      <div style="margin-top:20px;display:flex;flex-wrap:wrap;gap:12px;align-items:end;justify-content:center;">
        <div class="field">
          <label>Kelvin (color temperature)</label>
          <input type="range" id="kelvin" min="2700" max="6500" value="3000" step="50" style="width:260px;" />
          <span style="font-family:var(--mono);font-size:.62rem;color:var(--ink-dim);" id="kv-read">3000 K</span>
        </div>
        <div class="field">
          <label>Brightness</label>
          <input type="range" id="brightness" min="20" max="100" value="85" style="width:180px;" />
        </div>
      </div>

      <div style="display:flex;gap:8px;flex-wrap:wrap;justify-content:center;margin-top:12px;">
        {["Warm/Office","Neutral","Daylight","Cool/Stream"].map((p) => (
          <button class="btn btn-outline" data-preset={p} style="font-size:.75rem;padding:7px 12px;">{p}</button>
        ))}
      </div>

      <div style="margin-top:18px;border-top:1px solid var(--line);padding-top:14px;">
        <p style="font-family:var(--mono);font-size:.7rem;color:var(--ink-dim);text-transform:uppercase;letter-spacing:.04em;text-align:center;margin:0 0 8px;">One-click use-case presets</p>
        <div style="display:flex;gap:8px;flex-wrap:wrap;justify-content:center;">
          <button class="btn btn-outline" data-usecase="video-call" style="font-size:.75rem;padding:7px 12px;">Video Call Fill Light</button>
          <button class="btn btn-outline" data-usecase="tracing" style="font-size:.75rem;padding:7px 12px;">Flipbook Tracing</button>
          <button class="btn btn-outline" data-usecase="reading" style="font-size:.75rem;padding:7px 12px;">Reading Light</button>
        </div>
      </div>

      <div class="action-row">
        <button class="btn" id="full-btn">Full Screen</button>
        <button class="btn btn-outline" id="dl-btn">Download PNG</button>
      </div>
      <p class="hint">Tip: press F for full screen · Esc to exit</p>
    </div>

    <details open>
      <summary>What Kelvin setting should I use for Zoom calls?</summary>
      <p>Daylight (5000–5500 K) looks most natural on most webcams. If your room lighting is warm, match it around 3500 K. Cooler settings (6000 K+) can counter yellow room light but may look clinical.</p>
    </details>
    <details>
      <summary>Does screen brightness affect how I appear on camera?</summary>
      <p>Yes — raising brightness increases the fill light but can also wash out your face if set too high. Start around 60–70% and adjust until your face looks evenly lit without squinting.</p>
    </details>
    <details>
      <summary>Can I download a preset color as a PNG?</summary>
      <p>Absolutely. After you dial in the perfect shade with the Kelvin slider, hit Download PNG and save a full-resolution solid-color image for use anywhere.</p>
    </details>

    <RelatedTools slugs={tool.relatedSlugs} />
    <ColorHub t={t} />
    <ToolCards title="More Screen Tools" limit={6} />
  </div>
</BaseLayout>

<script>
// @ts-nocheck
  const presets = { "Warm/Office": 3000, "Neutral": 4200, "Daylight": 5500, "Cool/Stream": 6500 };
  const kelvin = document.getElementById("kelvin");
  const brightness = document.getElementById("brightness");
  const preview = document.getElementById("preview");
  const kvLabel = document.getElementById("kv-label");
  const kvRead = document.getElementById("kv-read");

  function kToHex(k) {
    const t = k / 100;
    let r, g, b;
    if (t <= 66) { r = 255; g = 99.4708025861 * Math.log(t) - 161.1195681661; b = t <= 19 ? 0 : 138.5177312231 * Math.log(t - 10) - 305.0447927307; }
    else { r = 329.698727446 * Math.pow(t - 60, -0.1332047592); g = 288.1221695283 * Math.pow(t - 60, -0.0755148492); b = 255; }
    const clamp = (v) => Math.min(255, Math.max(0, Math.round(v)));
    return `#${[clamp(r),clamp(g),clamp(b)].map(v=>v.toString(16).padStart(2,'0')).join('')}`;
  }

  function update() {
    const k = +kelvin.value;
    const hex = kToHex(k);
    const bright = brightness.value / 100;
    const darken = (h) => { const n=parseInt(h.slice(1),16); return '#'+[16,8,0].map(s=>(Math.round(((n>>s)&0xff)*bright)).toString(16).padStart(2,'0')).join(''); };
    preview.style.background = darken(hex);
    const label = Object.entries(presets).find(([,v])=>v===k)?.[0] || '';
    kvLabel.textContent = `${k} K${label ? ' \u2014 ' + label : ''}`;
    kvRead.textContent = `${k} K`;
  }

  kelvin.addEventListener("input", update);
  brightness.addEventListener("input", update);

  document.querySelectorAll("[data-preset]").forEach(btn => {
    btn.addEventListener("click", () => { kelvin.value = presets[btn.dataset.preset]; update(); });
  });

  document.getElementById("full-btn").addEventListener("click", () => {
    const ov = document.getElementById("overlay");
    ov.style.background = preview.style.background;
    ov.style.display = "flex";
    document.documentElement.requestFullscreen?.().catch(()=>{});
  });

  document.getElementById("dl-btn").addEventListener("click", () => {
    const c = document.createElement("canvas");
    c.width = 1920; c.height = 1080;
    const ctx = c.getContext("2d");
    ctx.fillStyle = preview.style.background;
    ctx.fillRect(0,0,1920,1080);
    c.toBlob(b=>{if(!b)return;const a=document.createElement("a");a.href=URL.createObjectURL(b);a.download=`zoom-light-${kelvin.value}k.png`;a.click();}, "image/png", 1.0);
  });

  const usecases = {
    "video-call": { k: 5500, b: 85, name: "Video Call Fill Light" },
    "tracing": { k: 6000, b: 100, name: "Flipbook Tracing" },
    "reading": { k: 3200, b: 80, name: "Reading Light" },
  };
  document.querySelectorAll("[data-usecase]").forEach(btn => {
    btn.addEventListener("click", () => {
      const u = usecases[btn.dataset.usecase];
      if (!u) return;
      kelvin.value = u.k;
      brightness.value = u.b;
      update();
      track('use_preset', { event_category: 'tool', event_label: u.name });
    });
  });

  window.__blankpaneFullscreen = () => document.getElementById("full-btn").click();
</script>
