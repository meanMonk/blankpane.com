---
import BaseLayout from "../layouts/BaseLayout.astro";
import ColorTool from "../components/ColorTool.astro";
import ColorHub from "../components/ColorHub.astro";
import ToolCards from "../components/ToolCards.astro";
import UseCaseAccordion from "../components/UseCaseAccordion.astro";
import { getUI } from "../i18n";
import colors from "../data/colors.json";

const t = getUI("en");
const site = "https://blankpane.com";
const tiles = colors.map((c) => ({ hex: c.hex, name: t.colorName[c.slug] ?? c.name, light: c.light, slug: c.slug }));
---

<BaseLayout
  lang="en"
  title="BlankPane | White Screen, Black Screen & Color Screen Tool"
  description={t.heroLede}
  canonical={`${site}/`}
  isHome
>
  <div class="content-shell">
    <div class="main-col">
      <header class="hero">
        <p class="eyebrow">{t.eyebrow}</p>
        <h1>{t.heroTitle}</h1>
      </header>

      <ColorTool t={t} tiles={tiles} />

      <p class="lede">{t.heroLede}</p>

      <ColorHub t={t} />
      <ToolCards title="Screen Tools" limit={6} />

      <UseCaseAccordion t={t} slug="white-screen" />

      <section id="uses">
        <h2>{t.usesTitle}</h2>
        <div class="use-grid">
          {t.uses.map((u) => (
            <div class="use-card">
              <h3>{u.title}</h3>
              <p>{u.body}</p>
            </div>
          ))}
        </div>
      </section>

      <section id="faq">
        <h2>{t.faqTitle}</h2>
        {t.faqs.map((f, i) => (
          <details open={i === 0}>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </section>
    </div>
  </div>
</BaseLayout>
