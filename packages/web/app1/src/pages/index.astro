---
import BaseLayout from "../layouts/BaseLayout.astro";
import ColorTool from "../components/ColorTool.astro";
import ColorHub from "../components/ColorHub.astro";
import ToolCards from "../components/ToolCards.astro";
import UseCaseAccordion from "../components/UseCaseAccordion.astro";
import WatchVideo from "../components/WatchVideo.astro";
import { guides } from "../data/guides";
import { getUI } from "../i18n";
import colors from "../data/colors.json";

const t = getUI("en");
const site = "https://blankpane.com";
const tiles = colors.map((c) => ({ hex: c.hex, name: t.colorName[c.slug] ?? c.name, light: c.light, slug: c.slug }));
---

<BaseLayout
  lang="en"
  title="White Screen, Black Screen & Color Screen — Free Fullscreen Background Tool"
  description="Open a white screen, black screen, or any solid color background full screen instantly in your browser. Free white background tool, plain color screens, PNG downloads, Zoom lighting, and monitor tests — no install."
  canonical={`${site}/`}
  isHome
>
  <div class="content-shell">
    <div class="main-col">
      <header class="hero">
        <p class="eyebrow">{t.eyebrow}</p>
        <h1>{t.heroTitle}</h1>
      </header>

      <ColorTool t={t} tiles={tiles} />

      <p class="lede">{t.heroLede}</p>

      <ColorHub t={t} />
      <ToolCards title="Screen Tools" limit={6} />

      <section style="border-top:1px solid var(--line);padding:28px 0;">
        <h2 style="text-align:left;font-size:1.2rem;margin:0 0 6px;">Learn with our guides</h2>
        <p style="color:var(--ink-dim);font-size:0.88rem;margin:0 0 14px;">Step-by-step walkthroughs for monitor testing, cleaning, lighting, focus, and more.</p>
        <div class="blog-grid">
          {guides.slice(0, 3).map((g) => (
            <a class="blog-card" href={`/guides/${g.slug}/`}>
              <h3>{g.title}</h3>
              <p>{g.excerpt}</p>
            </a>
          ))}
        </div>
        <p style="margin:14px 0 0;"><a href="/guides/">Browse all guides →</a></p>
      </section>

      <UseCaseAccordion t={t} slug="white-screen" />
      <WatchVideo t={t} />

      <section id="uses">
        <h2>{t.usesTitle}</h2>
        <div class="use-grid">
          {t.uses.map((u) => (
            <div class="use-card">
              <h3>{u.title}</h3>
              <p>{u.body}</p>
            </div>
          ))}
        </div>
      </section>

      <section id="faq">
        <h2>{t.faqTitle}</h2>
        {t.faqs.map((f, i) => (
          <details open={i === 0}>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </section>
    </div>
  </div>
</BaseLayout>
