---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getUI } from "../../i18n";
import colors from "../../data/colors.json";

const t = getUI("en");
const site = "https://blankpane.com";
---

<BaseLayout
  lang="en"
  localized={false}
  title="All Full-Screen Colors | BlankPane"
  description={t.popularLede}
  canonical={`${site}/colors/`}
>
  <div class="page">
    <p class="back"><a href="/">← {t.brandA}{t.brandB}</a></p>
    <h1>{t.popularTitle}</h1>
    <p class="lede">{t.popularLede}</p>
    <div class="color-links" style="justify-content:flex-start;">
      {colors.map((c) => (
        <a href={`/${c.slug}/`}>{t.colorName[c.slug] ?? c.name}</a>
      ))}
    </div>
  </div>
</BaseLayout>
