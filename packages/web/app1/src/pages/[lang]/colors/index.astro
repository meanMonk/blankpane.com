---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getUI, locales } from "../../../i18n";
import colors from "../../../data/colors.json";
import tools from "../../../data/tools.json";

export function getStaticPaths() {
  return locales.filter((l) => l.code !== "en").map((l) => ({ params: { lang: l.code } }));
}

const { lang } = Astro.params;
const t = getUI(lang);
const site = "https://blankpane.com";
const toolSlugs = ["screen-cleaner", "dead-pixel-test", "zoom-light-screen", "ring-light-screen", "screen-flashlight", "countdown-timer-fullscreen"];
---

<BaseLayout
  lang={lang}
  title={t.popularTitle}
  description={t.popularLede}
  canonical={`${site}/${lang}/colors/`}
>
  <div class="page">
    <p class="back"><a href={`/${lang}/`}>← {t.brandA}{t.brandB}</a></p>
    <h1>{t.popularTitle}</h1>
    <p class="lede">{t.popularLede}</p>

    <div class="color-links" style="justify-content:flex-start;margin-bottom:8px;">
      {colors.map((c) => (
        <a href={`/${lang}/${c.slug}/`}>{t.colorName[c.slug] ?? c.name}</a>
      ))}
    </div>

    <section id="tools" style="border-top:1px solid var(--line);padding:28px 0;">
      <h2 style="text-align:left;font-size:1.2rem;margin:0 0 6px;">Popular screen tools</h2>
      <p style="color:var(--ink-dim);font-size:.88rem;margin:0 0 14px;">Pair a color with a dedicated tool for cleaning, testing, or lighting.</p>
      <div class="blog-grid">
        {toolSlugs.map((slug) => {
          const tool = tools.find((x) => x.slug === slug);
          if (!tool) return null;
          return (
            <a class="blog-card" href={`/tools/${tool.slug}/`}>
              <h3 style="font-size:.9rem;">{tool.name}</h3>
              <p style="font-size:.8rem;">{tool.description}</p>
            </a>
          );
        })}
      </div>
    </section>

    <section id="uses" style="border-top:1px solid var(--line);padding:28px 0;">
      <h2 style="text-align:left;font-size:1.2rem;margin:0 0 14px;">{t.usesTitle}</h2>
      <div class="use-grid">
        {t.uses.map((u) => (
          <div class="use-card">
            <h3>{u.title}</h3>
            <p>{u.body}</p>
          </div>
        ))}
      </div>
    </section>

    <p style="text-align:center;margin:28px 0 0;">
      <a class="btn" href={`/${lang}/`} style="display:inline-block;">Open the full-screen color tool</a>
    </p>
  </div>
</BaseLayout>
