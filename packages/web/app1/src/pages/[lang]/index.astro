---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ColorTool from "../../components/ColorTool.astro";
import ColorHub from "../../components/ColorHub.astro";
import ToolCards from "../../components/ToolCards.astro";
import { getUI, locales } from "../../i18n";
import colors from "../../data/colors.json";

export function getStaticPaths() {
  return locales.filter((l) => l.code !== "en").map((l) => ({ params: { lang: l.code } }));
}

const { lang } = Astro.params;
const t = getUI(lang);
const site = "https://blankpane.com";
const tiles = colors.map((c) => ({ hex: c.hex, name: t.colorName[c.slug] ?? c.name, light: c.light, slug: c.slug }));
---

<BaseLayout
  lang={lang}
  title={t.heroTitle}
  description={t.heroLede}
  canonical={`${site}/${lang}/`}
>
  <div class="content-shell">
    <aside class="ad-rail"><div class="ad-slot">Ad space<br />300 × 600</div></aside>

    <div class="main-col">
      <header class="hero">
        <p class="eyebrow">{t.eyebrow}</p>
        <h1>{t.heroTitle}</h1>
      </header>

      <ColorTool t={t} tiles={tiles} />

      <p class="lede">{t.heroLede}</p>

      <ColorHub t={t} lang={lang} />
      <ToolCards title={lang === "de" ? "Bildschirmwerkzeuge" : lang === "fr" ? "Outils d'écran" : "Screen Tools"} limit={6} />

      <section id="uses">
        <h2>{t.usesTitle}</h2>
        <div class="use-grid">
          {t.uses.map((u) => (
            <div class="use-card">
              <h3>{u.title}</h3>
              <p>{u.body}</p>
            </div>
          ))}
        </div>
      </section>

      <section id="faq">
        <h2>{t.faqTitle}</h2>
        {t.faqs.map((f, i) => (
          <details open={i === 0}>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </section>
    </div>

    <aside class="ad-rail"><div class="ad-slot">Ad space<br />300 × 600</div></aside>
  </div>
</BaseLayout>
