---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getUI, locales } from "../../../i18n";
import { blogPosts } from "../../../data/blog";
import tools from "../../../data/tools.json";

export function getStaticPaths() {
  return locales.filter((l) => l.code !== "en").map((l) => ({ params: { lang: l.code } }));
}

const { lang } = Astro.params;
const t = getUI(lang);
const site = "https://blankpane.com";
const toolSlugs = ["dead-pixel-test", "zoom-light-screen", "screen-cleaner", "screen-flashlight"];
---

<BaseLayout
  lang={lang}
  title="BlankPane Blog — Monitor Tests, Zoom Backgrounds & Lighting Tips"
  description="Practical guides on using solid-color screens for dead-pixel testing, Zoom backgrounds, lighting, and focus."
  canonical={`${site}/${lang}/blog/`}
>
  <div class="page">
    <p class="back"><a href={`/${lang}/`}>← {t.brandA}{t.brandB}</a></p>
    <h1>Blog</h1>
    <p class="lede">Practical guides on using solid-color screens day to day.</p>

    <div class="blog-grid">
      {blogPosts.map((post) => (
        <a class="blog-card" href={`/blog/${post.slug}/`}>
          <div class="date">{post.date}</div>
          <h3>{post.title}</h3>
          <p>{post.excerpt}</p>
        </a>
      ))}
    </div>

    <section id="tools" style="border-top:1px solid var(--line);padding:28px 0;">
      <h2 style="text-align:left;font-size:1.2rem;margin:0 0 6px;">Try it now</h2>
      <p style="color:var(--ink-dim);font-size:.88rem;margin:0 0 14px;">Put these tips into practice with the free tools.</p>
      <div class="blog-grid">
        {toolSlugs.map((slug) => {
          const tool = tools.find((x) => x.slug === slug);
          if (!tool) return null;
          return (
            <a class="blog-card" href={`/tools/${tool.slug}/`}>
              <h3 style="font-size:.9rem;">{tool.name}</h3>
              <p style="font-size:.8rem;">{tool.description}</p>
            </a>
          );
        })}
      </div>
    </section>

    <section style="border-top:1px solid var(--line);padding:28px 0;text-align:center;">
      <h2 style="text-align:center;font-size:1.2rem;">Need a solid-color screen right now?</h2>
      <p style="color:var(--ink-dim);">Open the tool, pick a color, and go full screen in one tap.</p>
      <p style="margin:16px 0 0;">
        <a class="btn" href={`/${lang}/`} style="display:inline-block;">Open BlankPane</a>
      </p>
    </section>
  </div>
</BaseLayout>
