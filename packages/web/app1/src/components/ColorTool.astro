---
import type { UI } from "../i18n";
import ColorSwatches from "./ColorSwatches.astro";
import { screens, screensByColor } from "../data/screens";

interface Tile {
  hex: string;
  name: string;
  light?: boolean;
  slug?: string;
}

interface Props {
  t: UI;
  tiles: Tile[];
  initialHex?: string;
  initialName?: string;
  initialLight?: boolean;
  initialSlug?: string;
  lang?: string;
}

const { t, tiles, initialHex = "#ffffff", initialName = "", initialLight = true, initialSlug = "", lang } = Astro.props;
const initial = { hex: initialHex, name: initialName, light: initialLight, slug: initialSlug };

const serializable = {
  ui: {
    customColor: t.customColor,
    goFullScreen: t.goFullScreen,
    fullscreenHint: t.fullscreenHint,
    downloadPng: t.downloadPng,
    sizePreset: t.sizePreset,
    presetFHD: t.presetFHD,
    preset4K: t.preset4K,
    presetSquare: t.presetSquare,
    presetStory: t.presetStory,
    presetA4: t.presetA4,
    presetCustom: t.presetCustom,
    width: t.width,
    height: t.height,
    px: t.px,
  },
  initial,
  screens,
  screensByColor,
};
---

<div class="tool-panel">
  <div class="preview-stage" id="previewStage" title={t.fullscreenHint} tabindex="0">
    <div class="stage-info">
      <span class="stage-name" id="stageName">{initialName || "White"}</span>
      <span class="stage-meta" id="stageMeta">#FFFFFF · 1920 × 1080 px</span>
    </div>
    <span class="stage-fs-hint" id="stageFsHint">{t.fullscreenHint}</span>
    <button class="stage-expand" id="stageExpand" aria-label={t.openFull} title={t.fullscreenHint}>⛶</button>
  </div>

  <div class="control-row">
    <div class="field">
      <label for="sizePreset">{t.sizePreset}</label>
      <select id="sizePreset">
        <option value="1920x1080" selected>{t.presetFHD}</option>
        <option value="3840x2160">{t.preset4K}</option>
        <option value="1080x1080">{t.presetSquare}</option>
        <option value="1080x1920">{t.presetStory}</option>
        <option value="2480x3508">{t.presetA4}</option>
        <option value="custom">{t.presetCustom}</option>
      </select>
    </div>
    <div class="field dims">
      <label for="widthInput">{t.width}</label>
      <input type="number" id="widthInput" value="1920" min="1" max="8000" />
      <label for="heightInput">{t.height}</label>
      <input type="number" id="heightInput" value="1080" min="1" max="8000" />
      <span style="font-family:var(--mono);font-size:.72rem;color:var(--ink-dim);">{t.px}</span>
    </div>
    <div class="field">
      <label for="customPicker">{t.customColor}</label>
      <input type="color" id="customPicker" value={initialHex} />
    </div>
  </div>

  <div class="action-row">
    <button class="btn" id="goFullBtn" aria-keyshortcuts="F">{t.goFullScreen}</button>
    <button class="btn btn-outline" id="downloadBtn">{t.downloadPng}</button>
  </div>
</div>

<ColorSwatches t={t} tiles={tiles} currentSlug={initialSlug} lang={lang} />
<p class="hint">{t.hint}</p>

<section class="screens-section">
  <h2>Screens</h2>
  <div class="screen-viewer">
    <button type="button" class="screen-nav" id="screenPrev" aria-label="Previous screen">&larr;</button>
    <button type="button" class="screen-stage" id="screenStage" title="Open full size">
      <img id="screenImg" src="/screens/01-spiderweb-crack.png" alt="Spiderweb Crack" loading="lazy" />
      <span class="screen-label" id="screenLabel">Spiderweb Crack</span>
      <span class="screen-expand" aria-hidden="true">⛶</span>
    </button>
    <button type="button" class="screen-nav" id="screenNext" aria-label="Next screen">&rarr;</button>
  </div>
  <p class="screen-counter" id="screenCounter">1 / 23</p>
</section>

<script define:vars={{ cfg: serializable }}>
// @ts-nocheck
  const { initial, screens: allScreens, screensByColor } = cfg;

  const previewStage = document.getElementById("previewStage");
  const stageName = document.getElementById("stageName");
  const stageMeta = document.getElementById("stageMeta");
  const customPicker = document.getElementById("customPicker");
  const sizePreset = document.getElementById("sizePreset");
  const widthInput = document.getElementById("widthInput");
  const heightInput = document.getElementById("heightInput");

  let state = { hex: initial.hex, name: initial.name || "White", light: initial.light, slug: initial.slug || "" };

  function isLightHex(hex) {
    const h = hex.replace("#", "");
    const r = parseInt(h.substring(0, 2), 16);
    const g = parseInt(h.substring(2, 4), 16);
    const b = parseInt(h.substring(4, 6), 16);
    return 0.299 * r + 0.587 * g + 0.114 * b > 175;
  }

  function updatePreview() {
    previewStage.style.background = state.hex;
    previewStage.classList.toggle("light-bg", state.light);
    stageName.textContent = state.name;
    stageMeta.textContent = `${state.hex.toUpperCase()} · ${widthInput.value} × ${heightInput.value} px`;
  }

  let customPickerDebounce;
  customPicker.addEventListener("input", () => {
    const hex = customPicker.value;
    state.hex = hex;
    state.light = isLightHex(hex);
    state.name = "Custom";
    state.slug = "";
    updatePreview();
    setShown(state.slug);
    clearTimeout(customPickerDebounce);
    customPickerDebounce = setTimeout(() => {
      track('custom_color', { event_category: 'tool', event_label: hex });
    }, 1200);
  });

  sizePreset.addEventListener("change", () => {
    const val = sizePreset.value;
    track('preset_change', { event_category: 'tool', event_label: val });
    if (val === "custom") return;
    const [w, h] = val.split("x");
    widthInput.value = w;
    heightInput.value = h;
    updatePreview();
  });

  [widthInput, heightInput].forEach((inp) => {
    inp.addEventListener("input", () => {
      sizePreset.value = "custom";
      updatePreview();
    });
  });

  document.getElementById("goFullBtn").addEventListener("click", () => { track('fullscreen', { event_category: 'tool', event_label: state.name }); goFullScreen(state.hex); });
  document.getElementById("stageExpand").addEventListener("click", () => { track('fullscreen', { event_category: 'tool', event_label: state.name }); goFullScreen(state.hex); });
  previewStage.addEventListener("click", () => { track('fullscreen', { event_category: 'tool', event_label: state.name }); goFullScreen(state.hex); });
  previewStage.addEventListener("keydown", (e) => {
    if (e.key === "Enter" || e.key === " ") { e.preventDefault(); goFullScreen(state.hex); }
  });

  document.getElementById("downloadBtn").addEventListener("click", () => {
    const w = Math.min(8000, Math.max(1, parseInt(widthInput.value) || 1920));
    const h = Math.min(8000, Math.max(1, parseInt(heightInput.value) || 1080));
    track('download_png', { event_category: 'tool', event_label: `${state.name}-${w}x${h}` });
    const canvas = document.createElement("canvas");
    canvas.width = w;
    canvas.height = h;
    const ctx = canvas.getContext("2d");
    ctx.fillStyle = state.hex;
    ctx.fillRect(0, 0, w, h);
    canvas.toBlob(
      (blob) => {
        if (!blob) return;
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        const safeName = state.name.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "") || "color";
        a.href = url;
        a.download = `${safeName}-${w}x${h}.png`;
        document.body.appendChild(a);
        a.click();
        a.remove();
        URL.revokeObjectURL(url);
      },
      "image/png",
      1.0
    );
  });

  function goFullScreen(hex) {
    const ov = document.getElementById("overlay");
    if (!ov) return;
    ov.style.background = hex;
    ov.style.display = "flex";
    document.documentElement.requestFullscreen?.().catch(() => {});
  }
  function exitOverlay() {
    const ov = document.getElementById("overlay");
    if (!ov) return;
    ov.style.display = "none";
    if (document.fullscreenElement) document.exitFullscreen?.();
  }

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") exitOverlay();
  });
  document.addEventListener("fullscreenchange", () => {
    if (!document.fullscreenElement) {
      const ov = document.getElementById("overlay");
      if (ov) ov.style.display = "none";
    }
  });
  document.addEventListener("click", (e) => {
    const ov = document.getElementById("overlay");
    if (ov && ov.style.display === "flex" && e.target === ov) exitOverlay();
  });

  // Screens gallery: 1 per page, filtered by the page's color
  const screenStage = document.getElementById("screenStage");
  const screenImg = document.getElementById("screenImg");
  const screenLabel = document.getElementById("screenLabel");
  const screenCounter = document.getElementById("screenCounter");
  const screenPrev = document.getElementById("screenPrev");
  const screenNext = document.getElementById("screenNext");
  let shown = allScreens;
  let shownIdx = 0;

  function pickScreens(slug) {
    const list = slug && screensByColor[slug] ? allScreens.filter((s) => screensByColor[slug].includes(s.file)) : allScreens;
    return list.length ? list : allScreens;
  }

  function renderScreen() {
    const s = shown[shownIdx];
    if (!s) return;
    screenImg.src = `/screens/${s.file}.png`;
    screenImg.alt = s.label;
    screenLabel.textContent = s.label;
    screenCounter.textContent = `${shownIdx + 1} / ${shown.length}`;
    screenPrev.disabled = shown.length <= 1;
    screenNext.disabled = shown.length <= 1;
  }

  function setShown(slug) {
    shown = pickScreens(slug);
    shownIdx = 0;
    renderScreen();
  }

  screenPrev.addEventListener("click", () => {
    shownIdx = (shownIdx - 1 + shown.length) % shown.length;
    renderScreen();
    track('screen_nav', { event_category: 'tool', event_label: 'prev' });
  });
  screenNext.addEventListener("click", () => {
    shownIdx = (shownIdx + 1) % shown.length;
    renderScreen();
    track('screen_nav', { event_category: 'tool', event_label: 'next' });
  });
  screenStage.addEventListener("click", () => {
    const s = shown[shownIdx];
    if (!s) return;
    track('screen_open', { event_category: 'tool', event_label: s.file });
    openImage(`/screens/${s.file}.png`);
  });

  // Full-screen image viewer via the shared #overlay (fill the screen, no lightbox)
  function openImage(src) {
    const ov = document.getElementById("overlay");
    if (!ov) return;
    ov.style.background = "";
    ov.style.backgroundImage = `url('${src}')`;
    ov.style.backgroundSize = "contain";
    ov.style.backgroundPosition = "center";
    ov.style.backgroundRepeat = "no-repeat";
    ov.style.display = "flex";
    document.documentElement.requestFullscreen?.().catch(() => {});
  }

  updatePreview();
  setShown(state.slug);

  window.__blankpaneFullscreen = () => goFullScreen(state.hex);
</script>
