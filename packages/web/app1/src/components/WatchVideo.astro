---
import type { UI } from "../i18n";

interface Props {
  t: UI;
}

const { t } = Astro.props;
const src = "/videos/white-screen.mp4";
---

<section class="watch-video">
  <h2>{t.watchVideoTitle}</h2>
  <p class="center-lede">{t.watchVideoBody}</p>
  <p class="watch-video-cta">
    <button type="button" class="btn" id="watchVideoBtn" aria-keyshortcuts="V" aria-expanded="false">{t.watchVideoButton}</button>
  </p>
  <div class="watch-video-inline" id="watchVideoWrap" hidden>
    <video id="watchVideoPlayer" src={src} playsinline controls preload="none"></video>
  </div>
</section>

<script>
  // @ts-nocheck
  const btn = document.getElementById("watchVideoBtn");
  const wrap = document.getElementById("watchVideoWrap");
  const player = document.getElementById("watchVideoPlayer");

  function toggleVideo(force) {
    if (!btn || !wrap || !player) return;
    const show = force !== undefined ? force : wrap.hidden;
    if (show) {
      track('watch_video', { event_category: 'video', event_label: 'white-screen' });
      wrap.hidden = false;
      btn.setAttribute("aria-expanded", "true");
      player.play().catch(() => {});
      wrap.scrollIntoView({ behavior: "smooth", block: "nearest" });
    } else {
      player.pause();
      wrap.hidden = true;
      btn.setAttribute("aria-expanded", "false");
    }
  }

  btn?.addEventListener("click", () => toggleVideo());
  player?.addEventListener("ended", () => toggleVideo(false));
</script>
