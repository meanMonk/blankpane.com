---
import { screens } from "../data/screens";

interface Props {
  files?: string[];
  title?: string;
  lede?: string;
}

const { files, title = "Realistic Screen Wallpapers", lede } = Astro.props;
const items = files
  ? files
      .map((f) => screens.find((s) => s.file === f))
      .filter((s): s is NonNullable<typeof s> => Boolean(s))
  : screens;
---

<section class="screens-section">
  <h2 style="font-family:var(--display);font-size:1.1rem;margin:0 0 6px;text-align:center;">{title}</h2>
  {lede && <p class="center-lede" style="font-size:.85rem;color:var(--ink-dim);">{lede}</p>}
  <div class="screen-gallery">
    {items.map((s) => (
      <figure class="screen-card" data-src={`/screens/${s.file}.png`} data-label={s.label} tabindex="0" role="button" aria-label={`Open ${s.label} full screen`}>
        <img
          src={`/screens/${s.file}.png`}
          alt={`${s.label} — ${s.desc}`}
          loading="lazy"
          decoding="async"
          width="1344"
          height="768"
        />
        <figcaption>
          <h3>{s.label}</h3>
          <p>{s.desc}</p>
        </figcaption>
      </figure>
    ))}
  </div>
</section>

<script>
  // @ts-nocheck
  const cards = document.querySelectorAll(".screen-card");
  function openImage(src) {
    const ov = document.getElementById("overlay");
    if (!ov) return;
    ov.style.background = "";
    ov.style.backgroundImage = `url('${src}')`;
    ov.style.backgroundSize = "contain";
    ov.style.backgroundPosition = "center";
    ov.style.backgroundRepeat = "no-repeat";
    ov.style.display = "flex";
    document.documentElement.requestFullscreen?.().catch(() => {});
    window.track && window.track('screen_open', { event_category: 'tool', event_label: src });
  }
  cards.forEach((card) => {
    const open = () => openImage(card.dataset.src);
    card.addEventListener("click", open);
    card.addEventListener("keydown", (e) => { if (e.key === "Enter" || e.key === " ") { e.preventDefault(); open(); } });
  });
</script>

<style>
  .screen-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 14px;
    margin-top: 14px;
  }
  .screen-card {
    margin: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--bg-raised);
    box-shadow: 0 10px 30px -18px rgba(0, 0, 0, 0.5);
    cursor: pointer;
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
  }
  .screen-card:hover, .screen-card:focus-visible {
    transform: translateY(-3px);
    box-shadow: 0 0 0 3px var(--accent), 0 18px 40px -18px rgba(0, 0, 0, 0.6);
    border-color: var(--accent);
    outline: none;
  }
  .screen-card img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
  }
  .screen-card figcaption {
    padding: 10px 12px 12px;
  }
  .screen-card h3 {
    font-size: 0.82rem;
    margin: 0 0 4px;
  }
  .screen-card p {
    font-size: 0.74rem;
    color: var(--ink-dim);
    margin: 0;
    line-height: 1.45;
  }
</style>
