---
interface Props {
  ariaLabel?: string;
}

const { ariaLabel = "Theme" } = Astro.props;
const icons = {
  light:
    '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M1 12h2M21 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4"/></svg>',
  dark: '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>',
  system:
    '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>',
};
---

<div class="theme-switch" data-theme-group aria-label={ariaLabel}>
  <button type="button" data-theme-option="light" aria-label="Light theme" title="Light" set:html={icons.light}></button>
  <button type="button" data-theme-option="dark" aria-label="Dark theme" title="Dark" set:html={icons.dark}></button>
  <button type="button" data-theme-option="system" aria-label="System theme" title="System" set:html={icons.system}></button>
</div>
