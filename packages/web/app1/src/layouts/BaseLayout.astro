---
import "../styles/global.css";
import ThemeSwitcher from "../components/ThemeSwitcher.astro";
import FeedbackModal from "../components/FeedbackModal.astro";
import CookieBanner from "../components/CookieBanner.astro";
import PwaInstallBanner from "../components/PwaInstallBanner.astro";
import { getUI, locales, type UI } from "../i18n";

interface Props {
  title: string;
  description: string;
  lang?: string;
  langSwitcher?: boolean;
  canonical?: string;
  jsonLd?: object[];
  isHome?: boolean;
  localized?: boolean;
  robots?: string;
  keywords?: string;
}

const {
  title,
  description,
  lang = "en",
  langSwitcher = true,
  canonical,
  jsonLd = [],
  isHome = false,
  localized = true,
  robots = "index, follow",
  keywords = "",
} = Astro.props;

const t: UI = getUI(lang);
const localePrefix = lang === "en" ? "" : `/${lang}`;
const pageUrl = canonical ?? (Astro.url.origin + Astro.url.pathname);
const currentPath = lang !== "en" && Astro.url.pathname.startsWith(`/${lang}/`)
  ? Astro.url.pathname.slice(lang.length + 1)
  : Astro.url.pathname.replace(/\/$/, "") + "/";
const alternateLinks = localized
  ? locales.map((l) => ({
      code: l.code,
      href: (l.code === "en" ? "/" : `/${l.code}/`) + currentPath.replace(/^\//, ""),
    }))
  : [{ code: lang, href: Astro.url.pathname }];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: t.faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const webAppJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "BlankPane",
  applicationCategory: "UtilitiesApplication",
  operatingSystem: "Any",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  description: t.heroLede,
};

const orgJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "BlankPane",
  url: "https://blankpane.com",
  logo: "https://blankpane.com/og-image-home.png",
  sameAs: [
    "https://twitter.com/blankpane",
    "https://www.youtube.com/@blankpane",
  ],
};

const itemListJsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "BlankPane screen tools",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "White Screen", url: "https://blankpane.com/white-screen/" },
    { "@type": "ListItem", position: 2, name: "Black Screen", url: "https://blankpane.com/black-screen/" },
    { "@type": "ListItem", position: 3, name: "White Background Editor", url: "https://blankpane.com/white-background-editor/" },
    { "@type": "ListItem", position: 4, name: "White Wallpaper", url: "https://blankpane.com/white-wallpaper/" },
    { "@type": "ListItem", position: 5, name: "Green Screen", url: "https://blankpane.com/green-screen/" },
    { "@type": "ListItem", position: 6, name: "Dead Pixel Test", url: "https://blankpane.com/tools/dead-pixel-test/" },
    { "@type": "ListItem", position: 7, name: "Screen Cleaner", url: "https://blankpane.com/tools/screen-cleaner/" },
    { "@type": "ListItem", position: 8, name: "Countdown Timer", url: "https://blankpane.com/tools/countdown-timer-fullscreen/" },
    { "@type": "ListItem", position: 9, name: "Screen Guides", url: "https://blankpane.com/guides/" },
    { "@type": "ListItem", position: 10, name: "Screen Tools", url: "https://blankpane.com/tools/" },
  ],
};

const baseJsonLd: object[] = [webAppJsonLd, faqJsonLd];
if (isHome) baseJsonLd.unshift(orgJsonLd, itemListJsonLd);
const allJsonLd = [...baseJsonLd, ...jsonLd];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#4c6fff" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="application-name" content="BlankPane" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="BlankPane" />
    <script is:inline>
      // Theme: apply persisted choice before first paint to avoid flash (light/dark/system — colors only)
      (function () {
        var t = "system";
        try { t = localStorage.getItem("blankpane-theme") || "system"; } catch (e) {}
        document.documentElement.setAttribute("data-theme", t);
      })();
    </script>
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    <link rel="canonical" href={pageUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content="https://blankpane.com/og-image-home.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="robots" content={robots} />
    {alternateLinks.map((l) => (
      <link rel="alternate" hreflang={l.code} href={l.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={alternateLinks[0]!.href} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-G79NS7Y3R1"></script>
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2238719351022187" crossorigin="anonymous"></script>
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
        rel="stylesheet"
      />
    </noscript>
    {allJsonLd.map((obj) => (
      <script type="application/ld+json" set:html={JSON.stringify(obj)} />
    ))}
  </head>
  <body>
    <nav class="site-nav">
      <div class="nav-inner">
        <a class="brand" href={`${localePrefix}/`}>
          {t.brandA}<span>{t.brandB}</span>
        </a>
        <div class="nav-links">
          <a href={`${localePrefix}/tools/`} class="nav-link">Tools</a>
          {lang === "en" && (
            <a href={`${localePrefix}/guides/`} class="nav-link">Guides</a>
          )}
          {lang === "en" && (
            <a href="/white-wallpaper/" class="nav-link">Wallpaper</a>
          )}
          <a href={`${localePrefix}/colors/`} class="nav-link">{t.navColors}</a>
          <a href={`${localePrefix}/blog/`} class="nav-link">{t.navBlog}</a>
          <ThemeSwitcher ariaLabel={t.langLabel ?? "Theme"} />
          {langSwitcher && (
            <div class="lang-dropdown" data-lang-dropdown>
              <button class="lang-select" type="button" data-lang-toggle aria-label={t.langLabel}>
                {t.langLabel} ▾
              </button>
              <div class="lang-dropdown-content" data-lang-content>
                {alternateLinks.map((l) => (
                  <a href={l.href} class:list={{ active: l.code === lang }}>
                    {locales.find((x) => x.code === l.code)?.native ?? l.code}
                  </a>
                ))}
              </div>
            </div>
          )}
        </div>
      </div>
    </nav>

    <slot />

    <footer>
      <div class="wrap">
        <div class="foot-links">
          {lang === "en" && <a href="/guides/">Guides</a>}
          <a href={lang === "en" ? "/about/" : `/${lang}/about/`}>{t.footerAbout}</a>
          <a href={lang === "en" ? "/privacy-policy/" : `/${lang}/privacy-policy/`}>{t.footerPrivacy}</a>
          <a href={lang === "en" ? "/terms-of-service/" : `/${lang}/terms-of-service/`}>{t.footerTerms}</a>
          <a href={lang === "en" ? "/cookie-policy/" : `/${lang}/cookie-policy/`}>{t.footerCookies}</a>
          <a href={lang === "en" ? "/disclaimer/" : `/${lang}/disclaimer/`}>{t.footerDisclaimer}</a>
          <a href={lang === "en" ? "/contact/" : `/${lang}/contact/`}>{t.footerContact}</a>
        </div>
        <div class="foot-theme">
          <ThemeSwitcher ariaLabel="Theme" />
        </div>
        <div class="foot-badges">
          <a href="https://findly.tools/blankpane?utm_source=blankpane" target="_blank" rel="noopener noreferrer">
            <img src="https://findly.tools/badges/findly-tools-badge-light.svg" alt="Featured on Findly.tools" width="175" height="55" />
          </a>
          <a href="https://twelve.tools" target="_blank" rel="noopener noreferrer">
            <img src="https://twelve.tools/badge0-white.svg" alt="Featured on Twelve Tools" width="148" height="40" />
          </a>
          <a href="https://turbo0.com/item/blankpane" target="_blank" rel="noopener noreferrer">
            <img src="https://img.turbo0.com/badge-listed-light.svg" alt="Listed on Turbo0" />
          </a>
          <a href="https://startupfa.me/s/blankpane?utm_source=blankpane.com" target="_blank" rel="noopener noreferrer">
            <img src="https://startupfa.me/badges/featured-badge.webp" alt="BlankPane - Featured on Startup Fame" />
          </a>
          <a href="https://wired.business" target="_blank" rel="noopener noreferrer">
            <img src="https://wired.business/badge0-white.svg" alt="Featured on Wired Business" />
          </a>
          <a href="https://smollaunch.com" target="_blank" rel="noopener noreferrer">
            <img src="https://smollaunch.com/badges/featured.svg" alt="BlankPane — Featured on Smol Launch" loading="lazy" />
          </a>
        </div>
        <p>© 2026 BlankPane. {t.footerNote}</p>
      </div>
    </footer>

    <div id="overlay">
      <div class="exit-hint">{t.exitHint}</div>
    </div>

    <div id="oled-bar" hidden>
      <span>OLED Saver</span>
      <button type="button" id="oled-toggle" aria-pressed="false">Off</button>
      <span id="oled-timer">00:00</span>
    </div>

    <FeedbackModal />
    <CookieBanner />
    <PwaInstallBanner />

    <script>
      // @ts-nocheck
      window.dataLayer = window.dataLayer || [];
      window.gtag = function(){dataLayer.push(arguments);};
      window.track = function(name, params) { window.gtag('event', name, params || {}); };
      gtag('js', new Date());
      gtag('config', 'G-G79NS7Y3R1', { send_page_view: true });

      // page view analytics
      track('page_view_extra', { event_category: 'page', event_label: window.location.pathname, page_path: window.location.pathname, page_title: document.title });

      const dropdown = document.querySelector("[data-lang-dropdown]");
      if (dropdown) {
        const toggle = dropdown.querySelector("[data-lang-toggle]")!;
        const content = dropdown.querySelector("[data-lang-content]")!;
        toggle.addEventListener("click", (e) => {
          e.stopPropagation();
          content.classList.toggle("lang-show");
        });
        document.addEventListener("click", () => content.classList.remove("lang-show"));
        content.querySelectorAll("a").forEach(a => {
          a.addEventListener("click", () => {
            track('language_switch', { event_category: 'navigation', event_label: a.getAttribute('hreflang') || a.textContent.trim() });
          });
        });
      }

      // Theme switcher (light / dark / system — colors only)
      const themeGroups = document.querySelectorAll("[data-theme-group]");
      const themeMeta = document.querySelector('meta[name="theme-color"]');
      function applyTheme(t) {
        document.documentElement.setAttribute("data-theme", t);
        try { localStorage.setItem("blankpane-theme", t); } catch (e) {}
        themeGroups.forEach((group) => {
          group.querySelectorAll("[data-theme-option]").forEach((b) => {
            const active = b.dataset.themeOption === t;
            b.classList.toggle("theme-active", active);
            b.setAttribute("aria-pressed", String(active));
          });
        });
        const isLight = t === "light" || (t === "system" && window.matchMedia && window.matchMedia("(prefers-color-scheme: light)").matches);
        if (themeMeta) themeMeta.setAttribute("content", isLight ? "#f5f5f8" : "#4c6fff");
        track('theme_change', { event_category: 'ui', event_label: t });
      }
      themeGroups.forEach((group) => {
        group.querySelectorAll("[data-theme-option]").forEach((b) => {
          b.addEventListener("click", () => applyTheme(b.dataset.themeOption));
        });
      });
      applyTheme(document.documentElement.getAttribute("data-theme") || "system");
      if (window.matchMedia) {
        window.matchMedia("(prefers-color-scheme: light)").addEventListener("change", () => {
          if (document.documentElement.getAttribute("data-theme") === "system") applyTheme("system");
        });
      }

      document.querySelectorAll('.nav-link').forEach(a => {
        a.addEventListener('click', () => track('nav_click', { event_category: 'navigation', event_label: a.textContent.trim() }));
      });
      document.querySelector('.brand')?.addEventListener('click', () => track('nav_click', { event_category: 'navigation', event_label: 'brand_home' }));
      document.querySelectorAll('.foot-links a').forEach(a => {
        a.addEventListener('click', () => track('footer_click', { event_category: 'navigation', event_label: a.textContent.trim() }));
      });
      document.querySelectorAll('.color-links a').forEach(a => {
        a.addEventListener('click', () => track('color_link_click', { event_category: 'navigation', event_label: a.textContent.trim() }));
      });
      document.querySelectorAll('.blog-card').forEach(a => {
        a.addEventListener('click', () => track('card_click', { event_category: 'navigation', event_label: a.querySelector('h3')?.textContent?.trim() || a.getAttribute('href') }));
      });

      const ov = document.getElementById("overlay");
      if (ov) {
        ov.addEventListener("click", () => { ov.style.display = "none"; if (document.fullscreenElement) document.exitFullscreen?.(); });
        document.addEventListener("keydown", (e) => { if (e.key === "Escape" && ov.style.display === "flex") { ov.style.display = "none"; if (document.fullscreenElement) document.exitFullscreen?.(); } });
        document.addEventListener("fullscreenchange", () => { if (!document.fullscreenElement) ov.style.display = "none"; });

        // F-key fullscreen shortcut — pages can register a fill action via window.__blankpaneFullscreen
        document.addEventListener("keydown", (e) => {
          if (!e.key || e.key.toLowerCase() !== "f") return;
          if (e.metaKey || e.ctrlKey || e.altKey) return;
          const tag = (document.activeElement && document.activeElement.tagName || "").toLowerCase();
          if (tag === "input" || tag === "textarea" || tag === "select") return;
          e.preventDefault();
          if (ov.style.display === "flex") {
            if (document.fullscreenElement) document.exitFullscreen?.();
            else document.documentElement.requestFullscreen?.().catch(() => {});
          } else if (window.__blankpaneFullscreen) {
            window.__blankpaneFullscreen();
          } else {
            document.documentElement.requestFullscreen?.().catch(() => {});
          }
        });

        // OLED anti-burn-in saver: elapsed-time timer + pixel-shift toggle while overlay is showing
        const oledBar = document.getElementById("oled-bar");
        if (oledBar) {
          const oledToggle = document.getElementById("oled-toggle");
          const oledTimer = document.getElementById("oled-timer");
          let oledOn = false, oledStart = 0, oledInt = null;
          function oledFmt(s) { return String(Math.floor(s / 60)).padStart(2, "0") + ":" + String(s % 60).padStart(2, "0"); }
          function oledTick() { if (oledTimer) oledTimer.textContent = oledFmt(Math.floor((Date.now() - oledStart) / 1000)); }
          function oledShow() {
            oledBar.hidden = false;
            oledStart = Date.now();
            oledTick();
            clearInterval(oledInt);
            oledInt = setInterval(oledTick, 1000);
          }
          function oledHide() {
            oledBar.hidden = true;
            clearInterval(oledInt);
            oledInt = null;
            if (oledOn) { oledOn = false; if (oledToggle) oledToggle.setAttribute("aria-pressed", "false"); if (ov) ov.classList.remove("pixel-shift"); }
          }
          function oledSet(on) {
            oledOn = on;
            if (oledToggle) { oledToggle.textContent = on ? "On" : "Off"; oledToggle.setAttribute("aria-pressed", String(on)); }
            if (ov) ov.classList.toggle("pixel-shift", on);
            window.track && window.track('oled_saver', { event_category: 'tool', event_label: on ? 'on' : 'off' });
          }
          oledToggle && oledToggle.addEventListener("click", () => oledSet(!oledOn));
          const oledMO = new MutationObserver(() => { if (ov && ov.style.display === "flex") oledShow(); else oledHide(); });
          oledMO.observe(ov, { attributes: true, attributeFilter: ["style"] });
        }
      }

      // PWA: register service worker (installable app + offline) — skip localhost dev
      if ("serviceWorker" in navigator && location.hostname !== "localhost") {
        window.addEventListener("load", () => {
          navigator.serviceWorker.register("/sw.js").catch(() => {});
        });
      }
    </script>
  </body>
</html>
