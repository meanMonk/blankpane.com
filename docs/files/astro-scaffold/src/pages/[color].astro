---
import BaseLayout from '../layouts/BaseLayout.astro';
import colors from '../data/colors.json';

export function getStaticPaths() {
  return colors.map((c) => ({ params: { color: c.slug }, props: { c } }));
}

const { c } = Astro.props;
const title = `${c.name} — Full Screen ${c.name} Tool | Free & Instant`;
const description = `Open a full-page ${c.name.toLowerCase()} instantly in your browser. Free tool for ${c.intent}. No download, works on any device.`;
---
<BaseLayout title={title} description={description} canonical={`https://fullscreencolor.example.com/${c.slug}/`}>
  <main>
    <h1>Full Screen {c.name}</h1>
    <p>Tap below to fill your entire screen with {c.name.toLowerCase()} ({c.hex}). Commonly used for {c.intent}.</p>
    <button id="go" style={`background:${c.hex}`}>Open {c.name} Full Screen</button>
  </main>
  <script define:vars={{ hex: c.hex }}>
    document.getElementById('go').addEventListener('click', () => {
      document.body.style.background = hex;
      document.documentElement.requestFullscreen?.();
    });
  </script>
</BaseLayout>
